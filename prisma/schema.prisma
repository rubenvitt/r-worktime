// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
}

// User Model - Zentrale Benutzerverwaltung
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String
  name          String?
  role          UserRole  @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  settings      UserSettings?
  timeEntries   TimeEntry[]
  importLogs    ImportLog[]
  reviewedDays  ReviewedDay[]
  travelDays    TravelDay[]
  timingIntegration TimingIntegration?
  calendarIntegration CalendarIntegration?
  absences      Absence[]
  absenceSyncLogs AbsenceSyncLog[]
  vacationDrafts VacationDraft[]

  @@index([email])
  @@map("users")
}

// User Settings - Individuelle Benutzereinstellungen
model UserSettings {
  id                 String   @id @default(cuid())
  userId             String   @unique
  weeklyWorkHours    Decimal  @default(40.0) @db.Decimal(4, 2)
  workDays           Int[]    @default([1, 2, 3, 4, 5]) // 0=Sonntag, 1=Montag, ..., 6=Samstag
  annualVacationDays Decimal  @default(30) @db.Decimal(4, 1) // Jahresurlaubsanspruch in Tagen
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

// Time Entry - Einzelne Zeiteinträge
model TimeEntry {
  id            String      @id @default(cuid())
  userId        String
  date          DateTime    @db.Date
  startTime     DateTime
  endTime       DateTime
  duration      Decimal     @db.Decimal(5, 2) // In Stunden
  type          EntryType   @default(WORK)
  description   String?     // Kompatibilität: [title, notes].join(" - ")
  title         String?     // Aktivitätstitel aus Timing
  notes         String?     // Notizen aus Timing
  projectPath   String?     // Projektpfad, Segmente mit " ▸ " verbunden
  externalId    String?     // Stabile ID der Quelle (z. B. Timing "self")
  source        EntrySource @default(MANUAL)
  billingStatus String?     // Abrechnungsstatus aus Timing Import
  importLogId   String?
  absenceId     String?     // Verknüpfte Abwesenheit (Timewarp oder Dialog)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  // Relations
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  importLog  ImportLog?  @relation(fields: [importLogId], references: [id], onDelete: SetNull)
  absence    Absence?    @relation(fields: [absenceId], references: [id], onDelete: SetNull)

  @@unique([userId, externalId]) // NULLs mehrfach erlaubt
  @@index([userId, date, startTime])
  @@index([userId, date])
  @@index([userId, source])
  @@index([importLogId])
  @@index([absenceId])
  @@map("time_entries")
}

// Import Log - Historie der Timing-Importe
model ImportLog {
  id           String      @id @default(cuid())
  userId       String
  fileName     String
  fileHash     String      // SHA256 Hash zur Duplikatserkennung
  importDate   DateTime    @default(now())
  rowCount     Int
  status       ImportStatus
  errorMessage String?
  metadata     Json?       // Zusätzliche Import-Informationen

  // Relations
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  timeEntries  TimeEntry[]

  @@unique([userId, fileHash]) // Verhindert doppelte Imports
  @@index([userId, importDate])
  @@map("import_logs")
}

// Reviewed Day - Markierte Tage ohne/mit unvollständigen Einträgen
model ReviewedDay {
  id         String   @id @default(cuid())
  userId     String
  date       DateTime @db.Date
  reason     String?  // "Kein Arbeitstag", "Unbezahlter Urlaub", etc.
  reviewedAt DateTime @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
  @@map("reviewed_days")
}

// Travel Day - Manuelle Festlegung, ob ein Tag ein Reisetag ist
model TravelDay {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime @db.Date
  isTravel  Boolean  // true = Reisetag, false = ausdrücklich kein Reisetag
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
  @@map("travel_days")
}

// Timing Integration - REST-Sync-Konfiguration (bewusst getrennt von UserSettings,
// damit Backup/Export den Token nicht mitnehmen)
model TimingIntegration {
  id                  String    @id @default(cuid())
  userId              String    @unique
  apiTokenEnc         String?   // AES-256-GCM, Format v1:<iv>:<tag>:<ciphertext>
  projectRoots        String[]  @default(["Work"])
  syncEnabled         Boolean   @default(false)
  syncIntervalMinutes Int       @default(60)
  syncWindowDays      Int       @default(35)
  writeHolidays       Boolean   @default(false) // Feiertags-Einträge in Timing eintragen
  holidayProjectId    String?   // Timing-Projekt-Referenz für Feiertage
  holidaysSince       DateTime? @db.Date // erster Tag, der nach Timing geht (Einschalten)
  lastSyncAt          DateTime?
  lastSyncStatus      String?
  lastSyncError       String?
  lastSyncStats       Json?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("timing_integrations")
}

// Calendar Integration - Timewarp-Kalenderfeed (bewusst getrennt von
// UserSettings, damit Backup/Export die geheime Feed-URL nicht mitnehmen)
model CalendarIntegration {
  id              String    @id @default(cuid())
  userId          String    @unique
  feedUrlEnc      String?   // AES-256-GCM wie TimingIntegration.apiTokenEnc
  syncEnabled     Boolean   @default(false)
  writeToTiming   Boolean   @default(true)
  timingProjectId String?   // Timing-Projekt-Referenz für Urlaubseinträge
  lastSyncAt      DateTime?
  lastSyncStatus  String?
  lastSyncError   String?
  lastSyncStats   Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("calendar_integrations")
}

// Absence - Abwesenheit als Zeitraum (aus Timewarp oder dem Dialog); die
// einzelnen Tage sind TimeEntries mit absenceId
model Absence {
  id          String        @id @default(cuid())
  userId      String
  source      AbsenceSource
  externalUid String?       // Timewarp-UID
  kind        AbsenceKind
  rawType     String?       // Typtext aus SUMMARY nach dem Namen
  startDate   DateTime      @db.Date
  endDate     DateTime      @db.Date // inklusiv
  halfDay     Boolean       @default(false)
  status      AbsenceStatus
  sequence    Int?
  lastSeenAt  DateTime?
  // Tage "YYYY-MM-DD", deren Eintrag von Hand gelöscht oder bearbeitet wurde
  // (in R-Worktime oder in Timing): der Abgleich legt sie nicht neu an
  suppressedDates String[]  @default([])
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  // Relations
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  timeEntries TimeEntry[]

  @@unique([userId, externalUid]) // NULLs mehrfach erlaubt
  @@index([userId, startDate])
  @@map("absences")
}

// Absence Sync Log - Protokoll der Kalender-Abgleiche (letzte 50 je Nutzer)
// Entwurf im Urlaubsplaner: nur eine Planung, gebucht wird in Timewarp
model VacationDraft {
  id        String   @id @default(cuid())
  userId    String
  startDate DateTime @db.Date
  endDate   DateTime @db.Date // inklusiv
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startDate])
  @@map("vacation_drafts")
}

model AbsenceSyncLog {
  id         String    @id @default(cuid())
  userId     String
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  status     String
  error      String?
  actions    Json      // Liste {date, kind, action, detail}

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startedAt])
  @@map("absence_sync_logs")
}

// Enums
enum UserRole {
  USER
  ADMIN
}

enum EntryType {
  WORK      // Normale Arbeitszeit
  OVERTIME  // Überstunden
  VACATION  // Urlaub
  SICK      // Krankheit
  HOLIDAY   // Feiertag
  OVERTIME_REDUCTION // Überstundenabbau: Soll bleibt, keine Gutschrift
  UNPAID_LEAVE       // Unbezahlte Abwesenheit: Tagessoll 0
}

enum EntrySource {
  MANUAL       // Manuell angelegt (CRUD, Quick-Entry)
  FILE_IMPORT  // Timing-JSON-Datei
  TIMING_SYNC  // Timing REST-Sync
  BULK_FILL    // Massen-Auffüllung
  HOLIDAY      // Feiertagsimport
  ADJUSTMENT   // Anfangs-Überstunden-Saldo
  TIMEWARP     // Vom Timewarp-Abgleich angelegt
}

enum AbsenceSource {
  TIMEWARP
  MANUAL
}

enum AbsenceKind {
  VACATION
  RESIDUAL_VACATION
  SPECIAL_LEAVE
  EDUCATIONAL_LEAVE
  OVERTIME_REDUCTION
  UNPAID_LEAVE
  PARENTAL_LEAVE
  MATERNITY_LEAVE
  SABBATICAL
}

enum AbsenceStatus {
  ACTIVE
  CANCELLED
}

enum ImportStatus {
  PENDING
  SUCCESS
  PARTIAL
  FAILED
}